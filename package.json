{
  "name": "my-key-remapper",
  "version": "1.0.0",
  "type": "module",
  "author": "Yossuli",
  "description": "Windows Keyboard Remapper",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "ultracite check",
    "format": "ultracite format",
    "typecheck": "tsc --noEmit",
    "generate:types": "node scripts/cargo.mjs test -- model::export_bindings",
    "cargo:check": "node scripts/cargo.mjs check",
    "cargo:test": "node scripts/cargo.mjs test",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs --all",
    "watch:verify": "node scripts/watch-verify.mjs",
    "test:all": "node scripts/verify.mjs --all",
    "ultracite:fix": "npx ultracite fix",
    "ultracite:check": "npx ultracite check",
    "ultracite:doctor": "npx ultracite doctor",
    "ui:add": "npx shadcn@latest add",
    "reset:config": "powershell -Command \"Remove-Item -Path $env:APPDATA/my-key-remapper/key-mapping-config*.json -ErrorAction SilentlyContinue\""
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4.1.17",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.557.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-cli": "^0.1.2",
    "typescript": "^5.0.0",
    "ultracite": "^6.3.10",
    "vite": "^5.4.21"
  }
}
